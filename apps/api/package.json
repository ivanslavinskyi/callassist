{
  "name": "@callassist/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup && node scripts/copy-migrations.mjs",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:test:prepare": "tsx src/db/prepare-test-database.ts",
    "dev": "node --use-system-ca --import tsx src/index.ts",
    "lint": "tsc --noEmit",
    "start": "node --use-system-ca dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@callassist/contracts": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/websocket": "^11.3.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.4.0",
    "ffmpeg-static": "^5.3.0",
    "postgres": "^3.4.9",
    "twilio": "^6.0.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
