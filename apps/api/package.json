{
  "name": "@callassist/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "og:build-fallbacks": "node --import tsx scripts/build-og-fallbacks.ts",
    "eval:call-assessment": "tsx src/text-processing/final-assessment.eval.ts",
    "deployment:check": "tsx src/config/check-deployment.ts",
    "deployment:check:prod": "node dist/config/check-deployment.js",
    "communications:check": "tsx src/auth/check-communications.ts",
    "build": "tsup && node scripts/copy-migrations.mjs",
    "calls:disable": "tsx src/db/set-outbound-calls.ts disable",
    "calls:enable": "tsx src/db/set-outbound-calls.ts enable",
    "billing:sync:prod": "node --use-system-ca dist/db/sync-provider-billing.js",
    "billing:sync": "node --use-system-ca --import tsx src/db/sync-provider-billing.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:check": "tsx src/db/migrate.ts --check",
    "db:backfill:call-plans": "tsx src/db/backfill-call-compilations.ts",
    "db:classify:legacy-call-plans": "tsx src/db/classify-legacy-call-plans.ts",
    "db:verify:call-plan-cutover": "tsx src/db/verify-call-plan-cutover.ts",
    "db:reencrypt": "tsx src/db/reencrypt-data.ts",
    "db:recovery:drill": "tsx src/db/recovery-drill.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:backfill:call-plans:prod": "node dist/db/backfill-call-compilations.js",
    "db:classify:legacy-call-plans:prod": "node dist/db/classify-legacy-call-plans.js",
    "db:verify:call-plan-cutover:prod": "node dist/db/verify-call-plan-cutover.js",
    "db:reencrypt:prod": "node dist/db/reencrypt-data.js",
    "db:recovery:drill:prod": "node dist/db/recovery-drill.js",
    "calls:disable:prod": "node dist/db/set-outbound-calls.js disable",
    "calls:enable:prod": "node dist/db/set-outbound-calls.js enable",
    "db:test:prepare": "tsx src/db/prepare-test-database.ts",
    "dev": "node --use-system-ca --import tsx src/index.ts",
    "drill:real-call": "node --use-system-ca scripts/run-real-call-drill.mjs",
    "drill:real-call:inspect": "node --use-system-ca --import tsx scripts/inspect-real-call-drill.mjs",
    "worker": "node --use-system-ca --import tsx src/worker.ts",
    "lint": "tsc --noEmit",
    "start": "node --use-system-ca dist/index.js",
    "start:worker": "node --use-system-ca dist/worker.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@callassist/contracts": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/websocket": "^11.3.0",
    "@vercel/og": "0.8.6",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "fontkit": "^2.0.4",
    "postgres": "^3.4.9",
    "sharp": "0.35.4",
    "twilio": "^6.0.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
