{
  "name": "callassist",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "turbo build",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "pnpm --filter @callassist/api db:migrate",
    "db:test:prepare": "pnpm --filter @callassist/api db:test:prepare",
    "db:up": "docker compose up -d --wait postgres",
    "dev": "turbo dev",
    "env:init": "node scripts/init-env.mjs",
    "lint": "turbo lint",
    "test": "turbo test",
    "tunnel:twilio": "node scripts/start-twilio-tunnel.mjs",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
