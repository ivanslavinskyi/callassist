{
  "name": "callassist",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "deployment:check": "corepack pnpm --filter @callassist/api deployment:check",
    "communications:check": "corepack pnpm --filter @callassist/api communications:check",
    "build": "turbo build",
    "copy:check": "node scripts/check-public-copy.mjs",
    "locales:review": "corepack pnpm --filter @callassist/api exec tsx ../../scripts/export-rm-review.ts",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "corepack pnpm --filter @callassist/api db:migrate",
    "db:migrate:check": "corepack pnpm --filter @callassist/api db:migrate:check",
    "db:backfill:call-plans": "corepack pnpm --filter @callassist/api db:backfill:call-plans",
    "db:classify:legacy-call-plans": "corepack pnpm --filter @callassist/api db:classify:legacy-call-plans",
    "db:verify:call-plan-cutover": "corepack pnpm --filter @callassist/api db:verify:call-plan-cutover",
    "db:reencrypt": "corepack pnpm --filter @callassist/api db:reencrypt",
    "db:recovery:drill": "corepack pnpm --filter @callassist/api db:recovery:drill",
    "db:test:prepare": "corepack pnpm --filter @callassist/api db:test:prepare",
    "db:up": "docker compose up -d --wait postgres",
    "dev": "turbo dev",
    "env:init": "node scripts/init-env.mjs",
    "lint": "turbo lint",
    "security:audit": "corepack pnpm audit --audit-level low",
    "test": "turbo test",
    "tunnel:twilio": "node scripts/start-twilio-tunnel.mjs",
    "typecheck": "turbo typecheck",
    "license:check": "node scripts/check-license.mjs && node --test scripts/check-license.test.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "axios@>=1.0.0 <1.20.0": "1.20.0",
      "fast-uri@>=3.0.0 <3.1.8": "3.1.8",
      "fast-uri@>=4.0.0 <4.1.5": "4.1.5",
      "fflate@0.7.3": "0.7.5",
      "tsup>esbuild": "0.28.1",
      "@next/eslint-plugin-next@15.5.26>fast-glob": "npm:glob@13.0.6",
      "postcss": "8.5.23",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "sharp": "0.35.4"
    },
    "patchedDependencies": {
      "@next/eslint-plugin-next@15.5.26": "patches/@next__eslint-plugin-next@15.5.26.patch"
    }
  },
  "license": "UNLICENSED"
}
