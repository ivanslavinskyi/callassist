# Server-only secrets. Never expose these values to the browser.
STORAGE_DRIVER=postgres
TELEPHONY_DRIVER=mock
DATABASE_URL=postgresql://callassist:callassist-dev@localhost:56432/callassist
TEST_DATABASE_URL=postgresql://callassist:callassist-dev@localhost:56432/callassist_test
DATA_ENCRYPTION_KEY=
PROMO_CODE_HASH_KEY=
POSTGRES_PASSWORD=callassist-dev
POSTGRES_PORT=56432

NEXT_PUBLIC_API_URL=http://localhost:4000
# Canonical public web origin used by metadata, sitemap, robots, and SEO audit.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-rendered route guards use this private API origin when it differs from
# the browser-facing API URL (for example, http://api:4000 in a container network).
INTERNAL_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_BASE_URL=
TWILIO_WEBHOOK_PORT=4001

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
VERIFICATION_DRIVER=mock
MOCK_VERIFICATION_CODE=000000

# Public-beta outbound admission limits.
CALL_MAX_STARTS_PER_HOUR=3
CALL_MAX_STARTS_PER_DAY=10
CALL_MAX_STARTS_PER_RECIPIENT_PER_DAY=2
CALL_MAX_DURATION_SECONDS=900

# Process-local expensive endpoint limits. Shared IP budgets are 5x these values.
API_RATE_LIMIT_BRIEF_PREPARATION_PER_HOUR=15
API_RATE_LIMIT_CALL_START_PER_15_MINUTES=10
API_RATE_LIMIT_PROMO_REDEMPTION_PER_HOUR=10
API_RATE_LIMIT_RECORDING_DOWNLOAD_PER_HOUR=30
API_RATE_LIMIT_TRANSCRIPTION_RETRY_PER_DAY=5

OPENAI_API_KEY=
BRIEF_COMPILER_DRIVER=mock
OPENAI_BRIEF_COMPILER_MODEL=gpt-5.6
OPENAI_BRIEF_COMPILER_TIMEOUT_MS=90000
OPENAI_BRIEF_COMPILER_REQUEST_TIMEOUT_MS=25000
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIPTION_MODEL=gpt-realtime-whisper
OPENAI_TRANSCRIPTION_DELAY=high
OPENAI_POST_CALL_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_POST_CALL_UTTERANCE_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_REALTIME_MALE_VOICE=cedar
OPENAI_REALTIME_FEMALE_VOICE=marin
